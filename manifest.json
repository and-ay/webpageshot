{
  "manifest_version": 3,
  "name": "WebPageShot",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "{3256103e-f142-4ef4-9bef-ae0f50fbb53a}",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "downloads", "storage", "offscreen", "contextMenus", "clipboardWrite"],
  "commands": {
    "shot-visible": {
      "suggested_key": { "default": "Alt+S" },
      "description": "__MSG_cmdVisible__"
    },
    "shot-full": {
      "suggested_key": { "default": "Alt+A" },
      "description": "__MSG_cmdFull__"
    },
    "shot-region": {
      "suggested_key": { "default": "Alt+R" },
      "description": "__MSG_cmdRegion__"
    },
    "shot-element": {
      "suggested_key": { "default": "Alt+B" },
      "description": "__MSG_cmdElement__"
    }
  }
}
